# Load tools experiment, shape "burst": a batch of requests at once, then a pause, again and again. Run with
#     ./srv/bin/python3 experiments/load-tools/run.py --config experiments/load-tools/burst.config
# oha sends each burst as fast as its connections allow; k6 spreads it over one second. A level is missed when less
# than 95 % of the bursts' requests are answered.

# --- What is measured
SERVERS=erlang-nobw erlang-bw java
TOOLS=idle oha k6
SHAPE=burst
BURSTS=1000 5000 20000                                # requests per burst
BURST_EVERY_SECONDS=5                                 # from one burst to the next
RATE_GROWTH=0                                         # the listed levels only
CONNECTIONS=1000                                      # connections a burst is spread over
SECONDS=60
WARMUP_SECONDS=20
PYTHON_REQUESTS=60000
REPEATS=3

# --- Where it runs
DEPLOY=docker native
SYSTEM_CPUS=0,4
TOOL_CPUS=1,5
SERVER_CPUS=2,3,6,7

# --- The machine: as the paper's HTTP campaigns
MACHINE=minimal
ENV_CPU_SPEED=1800
IDLE_SECONDS=0
