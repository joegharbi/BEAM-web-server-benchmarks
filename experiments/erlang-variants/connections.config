# Many connections experiment (experiments/erlang-variants): what does holding an open connection cost each server
# design? The total rate is the same at every level (RATES, held by every server); only the number of open
# connections changes, so at 25,000 connections each one sends a request every 2.5 s and most are idle.
# 25,000 is just under the laptop's limit of about 28,000 connections from one address to one address and port
# (net.ipv4.ip_local_port_range 32768 60999), so nothing on the machine changes. Run with
#     ./srv/bin/python3 experiments/load-tools/run.py --config experiments/erlang-variants/connections.config
# The servers are the two-by-two and the two frameworks of designs.config (busy-waiting off), and as variants
# (variants.list): Cowboy without its two limits on a connection (cowboy-open), with only the 5 s idle limit off
# (cowboy-noidle) or only the 1,000 requests limit off (cowboy-nomax), and Netty with one worker per CPU.

# --- What is measured
SERVER_IMAGES=erl-conn=lt-erlang-a-nobw erl-loop=lt-erlang-f-nobw java-conn=st-java-pure-27 java-loop=lt-java-loop netty=st-java-netty-4-2-19 cowboy=st-erlang-cowboy-29-1-1-nobw cowboy-open=lt-cowboy-open-nobw cowboy-noidle=lt-cowboy-noidle-nobw cowboy-nomax=lt-cowboy-nomax-nobw netty-wcpus=lt-netty-wcpus
SERVERS=erl-conn erl-loop java-conn java-loop netty cowboy cowboy-open cowboy-noidle cowboy-nomax netty-wcpus
TOOLS=idle oha                                        # wrk2 cannot hold 25,000 connections on 2 CPUs (its own CPUs fill up)
SHAPE=connections
CONNECTION_LEVELS=100 1000 5000 10000 20000 25000     # open connections; every level runs
RATES=10000                                           # requests per second in total, at every level
RATE_GROWTH=0
MAX_P99_MS=0                                          # no latency rule: p99 includes the opening of the connections
OPEN_SECONDS=30                                       # the steadiness rule starts here (oha opens 25,000 in about 20 s)
CONNECTIONS=100                                       # the warm-up's connections
SECONDS=90                                            # 30 s of opening and 60 s steady
WARMUP_SECONDS=20
PYTHON_REQUESTS=60000
REPEATS=3

# --- Where it runs
DEPLOY=native
SYSTEM_CPUS=0,4
TOOL_CPUS=1,5
SERVER_CPUS=2,3,6,7

# --- The machine: as the paper's HTTP campaigns
MACHINE=minimal
ENV_CPU_SPEED=1800
IDLE_SECONDS=0
