#!/bin/sh
# Test stand-in for sudo: drops sudo's own options (-v, -n, -E, ...) and runs the
# command as the current user. With no command left (e.g. `sudo -v`), succeeds.
while [ $# -gt 0 ]; do
    case "$1" in
        -*) shift ;;
        *) break ;;
    esac
done
[ $# -eq 0 ] && exit 0
exec "$@"
