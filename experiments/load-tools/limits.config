# Load tools experiment, follow-up: the servers' own limits, in Docker and natively. Run with
#     ./srv/bin/python3 experiments/load-tools/run.py --config experiments/load-tools/limits.config
# The night run (load-tools.config) found that only wrk2 and oha reach a server's limit with the tool on 2 CPUs
# (Erlang at about 32,000-38,000 req/s; Java above 67,000, where docker-proxy was the bottleneck). This run steps
# finely from 20,000 req/s, where both tools held on every server, with Docker and native side by side.

# --- What is measured
SERVERS=erlang-nobw erlang-bw java
TOOLS=idle wrk2 oha
RATES=20000 25000 30000 35000 40000 45000 50000 60000 70000 80000
SECONDS=60
CONNECTIONS=100
WARMUP_SECONDS=20
PYTHON_REQUESTS=60000
REPEATS=3

# --- Where it runs
DEPLOY=docker native
SYSTEM_CPUS=0,4
TOOL_CPUS=1,5
SERVER_CPUS=2,3,6,7

# --- The machine: as the paper's HTTP campaigns
MACHINE=minimal
ENV_CPU_SPEED=1800
IDLE_SECONDS=0
