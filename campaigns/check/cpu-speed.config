# Short check of ENV_CPU_SPEED: the CPU fixed at a lower speed (1200 MHz) for the whole run; the
# readiness check expects exactly that speed. One server, busy-waiting as built and off, about 4 min.
# Expect "Expected CPU speed: 1200 MHz (set)", rows with "Host CPU Speed Limit Min (MHz)" 1200, and the
# CPU limits restored afterwards.
#   make run CONFIG=campaigns/check/cpu-speed.config
MACHINE=minimal
ENV_CPU_SPEED=1200
MEASURE=static
SERVERS=st-erlang-cowboy-29-1-1
VARIANTS=nobw:ERL_FLAGS=+sbwt none +sbwtdcpu none +sbwtdio none
REPEATS=1
IDLE_SECONDS=0
HTTP_REQUESTS=5000
