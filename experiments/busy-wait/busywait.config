# Experiment: does BEAM scheduler busy-waiting cause the jumps in container energy seen in the pilot?
# Each server is measured as it is and as "<server>-nobw" (busy-waiting off: +sbwt none +sbwtdcpu none
# +sbwtdio none), in a shuffled order. Build the -nobw images first: bash experiments/busy-wait/build.sh
#   make run CONFIG=experiments/busy-wait/busywait.config
MACHINE=minimal
MEASURE=static
SERVERS=st-elixir-cowboy-1-19-5 static:st-elixir-cowboy-1-19-5-nobw st-elixir-pure-1-19-5 static:st-elixir-pure-1-19-5-nobw st-erlang-cowboy-28-4-3 static:st-erlang-cowboy-28-4-3-nobw
HTTP_REQUESTS=20000 80000
REPEATS=5
IDLE_SECONDS=0
