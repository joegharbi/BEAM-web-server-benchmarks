# Profile: remote
# A machine you control but reach over the network (SSH): your desktop, a lab or university server
# reserved for you. As much control as is safe from a distance: the CPU is fixed and other containers
# are stopped, but nothing that could cut your connection is touched. Settings a machine does not
# have (no screen, no battery, no Bluetooth) are skipped.
# Used by a measurement file with MACHINE=remote. Only machine settings belong here.
#
# Settings not listed here have their default value (every setting: docs/CONFIG.md).

# CPU at one fixed speed, no turbo, no other containers running
ENV_GOVERNOR=performance
ENV_TURBO=off
ENV_STOP_CONTAINERS=1

# Screen and keyboard light dimmed where there are any; Wi-Fi never switched off (it may carry
# your SSH session); Bluetooth off
ENV_SCREEN_BRIGHTNESS=1
ENV_KEYBOARD_LIGHT=off
ENV_WIFI=unchanged
ENV_BLUETOOTH=off

# Nobody may be at the machine to fix things: wait for calm, but do not wait forever. After
# READY_MAX_WAIT_SECONDS it stops cleanly (machine restored) and can be continued with make resume.
ON_BATTERY=wait
READY_MAX_WAIT_SECONDS=900
READY_ON_TIMEOUT=stop
