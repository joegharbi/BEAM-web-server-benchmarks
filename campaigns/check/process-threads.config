# Two-minute check: one BEAM server, one load level, one run, with the real Scaphandre.
# Afterwards the run's raw/<run>.window.json must show "thread_handling": "tgid", a non-empty
# "thread_ids" list, and the CSV must show container energy below host energy.
#   make run CONFIG=campaigns/check/process-threads.config
MACHINE=minimal
MEASURE=static
SERVERS=st-erlang-pure-29-1-1
REPEATS=1
IDLE_SECONDS=0
HTTP_REQUESTS=20000
