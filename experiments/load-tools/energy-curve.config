# Load tools experiment: the energy against load curve. Run with
#     ./srv/bin/python3 experiments/load-tools/run.py --config experiments/load-tools/energy-curve.config
# Every tool first finds its limit on the server (as find-limits.config, and an answer counts only when 99 % of them
# arrive within MAX_P99_MS), then runs at LOAD_PERCENTS of that limit, in a shuffled order.
# No k6 here: on the tool's 2 CPUs its limit is its own (about 9,300 req/s), not the server's.

# --- What is measured
SERVERS=erlang-nobw erlang-bw java
TOOLS=idle wrk2 oha
SHAPE=rate
RATES=20000                                           # the first step, requests per second
RATE_GROWTH=2                                         # then doubling until a step is missed
MAX_RATE=1000000
LIMIT_PRECISION_PCT=5                                 # then searching the limit until held and missed are this close
MAX_P99_MS=100                                        # a step is also missed when p99 is above this
LOAD_PERCENTS=10 25 50 75 100                         # of the highest rate held
CONNECTIONS=100
SECONDS=60
WARMUP_SECONDS=20
PYTHON_REQUESTS=60000
REPEATS=3

# --- Where it runs
DEPLOY=docker native
SYSTEM_CPUS=0,4
TOOL_CPUS=1,5
SERVER_CPUS=2,3,6,7

# --- The machine: as the paper's HTTP campaigns
MACHINE=minimal
ENV_CPU_SPEED=1800
IDLE_SECONDS=0
