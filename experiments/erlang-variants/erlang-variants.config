# Erlang variants experiment (experiments/erlang-variants): does an Erlang server built more like Netty cost less?
# The images come from experiments/erlang-variants/build.sh (run it once). Run with
#     ./srv/bin/python3 experiments/load-tools/run.py --config experiments/erlang-variants/erlang-variants.config
# Variants (server/src/hello.erl): a = the framework's server, b = a with lean request code, c = b with data as
# messages, d = b as an event loop (one worker per scheduler), e = d on the socket backend; each with busy-waiting
# on (bw) and off (nobw), next to Java (Netty). Natively, so that docker-proxy is not the limit; wrk2, because it
# reaches every server's limit from 2 CPUs.

# --- What is measured
SERVER_IMAGES=erl-a-nobw=lt-erlang-a-nobw erl-a-bw=lt-erlang-a erl-b-nobw=lt-erlang-b-nobw erl-b-bw=lt-erlang-b erl-c-nobw=lt-erlang-c-nobw erl-c-bw=lt-erlang-c erl-d-nobw=lt-erlang-d-nobw erl-d-bw=lt-erlang-d erl-e-nobw=lt-erlang-e-nobw erl-e-bw=lt-erlang-e
SERVERS=erl-a-nobw erl-b-nobw erl-c-nobw erl-d-nobw erl-e-nobw erl-a-bw erl-b-bw erl-c-bw erl-d-bw erl-e-bw java
TOOLS=idle wrk2
SHAPE=rate
RATES=20000                                           # the first step, requests per second
RATE_GROWTH=2                                         # then doubling until a step is missed
MAX_RATE=1000000
LIMIT_PRECISION_PCT=5
MAX_P99_MS=100
LOAD_PERCENTS=10 50 100                               # of the highest rate held
CONNECTIONS=100
SECONDS=60
WARMUP_SECONDS=20
PYTHON_REQUESTS=60000
REPEATS=3

# --- Where it runs
DEPLOY=native
SYSTEM_CPUS=0,4
TOOL_CPUS=1,5
SERVER_CPUS=2,3,6,7

# --- The machine: as the paper's HTTP campaigns
MACHINE=minimal
ENV_CPU_SPEED=1800
IDLE_SECONDS=0
