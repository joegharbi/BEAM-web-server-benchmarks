<erl>
%% GET returns the page with the current time, POST returns 204 (like the other dynamic servers).
%% The whole page is made here, so nothing outside this block is sent.
out(A) ->
    case (A#arg.req)#http_request.method of
        'POST' ->
            {status, 204};
        _ ->
            {{Year,Month,Day},{Hour,Min,Sec}} = erlang:localtime(),
            TimeStr = io_lib:format("~4..0w-~2..0w-~2..0w ~2..0w:~2..0w:~2..0w",
                                    [Year, Month, Day, Hour, Min, Sec]),
            {html, ["<html>\n<head>\n    <title>Energy Test</title>\n</head>\n<body>\n    <h1>Hello, Energy Test!</h1>\n    <p>Current time: ",
                    TimeStr, "</p>\n</body>\n</html>"]}
    end.
</erl>