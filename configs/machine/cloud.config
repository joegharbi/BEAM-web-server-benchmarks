# Profile: cloud
# A rented machine in the cloud. Energy can only be measured where the CPU's energy counters (RAPL)
# are visible: bare-metal instances, or virtual machines that pass them through; the measurement
# stops at the start with a clear message where they are missing. CPU settings are applied where
# the provider allows them, and skipped (and recorded) where it does not. Other customers on the same
# hardware make noise you cannot remove, so the machine may never be fully calm: it measures after
# waiting and records why in the CSV ("Ready Check"). Plan more REPEATS than on your own machine.
# Used by a measurement file with MACHINE=cloud. Only machine settings belong here.
#
# Settings not listed here have their default value (every setting: docs/CONFIG.md).

# CPU at one fixed speed and no turbo where the provider allows it; your own other containers stopped
ENV_GOVERNOR=performance
ENV_TURBO=off
ENV_POWER_PROFILE=performance
ENV_PAUSE_TIMERS=maintenance
ENV_STOP_CONTAINERS=1

# No screen, keyboard light or radios to change on a cloud machine; never touch its network
ENV_SCREEN_BRIGHTNESS=unchanged
ENV_KEYBOARD_LIGHT=unchanged
ENV_WIFI=unchanged
ENV_BLUETOOTH=unchanged

# Shared hardware: the CPU use of others counts too, so compare with the machine's own resting use
# (measured at the start) and allow more; wait up to 10 minutes, then measure and record why
READY_CPU_BUSY_MARGIN_PERCENT=15
READY_MAX_WAIT_SECONDS=600
READY_ON_TIMEOUT=measure
