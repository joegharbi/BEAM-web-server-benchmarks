# Paper campaign (MIPRO, "BEAM Scheduler Busy-Waiting and Energy Measurement"), part "websocket":
# all servers in benchmarks/ (Erlang, Elixir, Gleam; Java as a reference), each as built and
# with BEAM busy-waiting off (-nobw; not for Java, which does not read ERL_FLAGS), each in Docker and
# natively, in one shuffled order. 440 measurements, about 10 h (pilot 2026-10-08).
#   make run CONFIG=campaigns/paper/websocket.config
# Decisions (2026-10-07):
#   - 5 repeats: the pilot gave whole-machine CV 0.4-2.7%, container CV <= 3.3% without busy-waiting
#   - CPU fixed at 1800 MHz (the rated speed of the i7-10610U): same speed in every run, no turbo
#   - no idle measurement: an idle server draws 0.1-2 mW
MACHINE=minimal
ENV_CPU_SPEED=1800
MEASURE=websocket
VARIANTS=nobw:ERL_FLAGS=+sbwt none +sbwtdcpu none +sbwtdio none
DEPLOY=container native
REPEATS=5
IDLE_SECONDS=0
# Burst and stream only, 100 clients, 8 KB and 1 MB messages: busy-waiting matters while the server
# waits between messages, which stream (10 messages per second per client) tests directly.
# Concurrency (up to 5000 clients) and 64 MB payloads answer other questions and are left out.
WS_BURST_CLIENTS=100
WS_BURST_SIZES_KB=8 1024
WS_STREAM_CLIENTS=100
WS_STREAM_SIZES_KB=8 1024
