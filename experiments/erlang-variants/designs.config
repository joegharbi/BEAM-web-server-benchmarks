# Server designs experiment (experiments/erlang-variants): language x design, each server at steps of its own limit.
# The images come from experiments/erlang-variants/build.sh (run it once). Run with
#     ./srv/bin/python3 experiments/load-tools/run.py --config experiments/erlang-variants/designs.config
#
# The two-by-two, all with the same request code as the framework's plain servers:
#                  one process/thread per connection         event loop, one worker per CPU
#   plain Erlang   erl-conn (variant a = st-erlang-pure)      erl-loop (variant f)
#   plain Java     java-conn (st-java-pure, virtual threads)  java-loop (lt-java-loop)
# Frameworks as they come: cowboy, netty. Optimised Erlang (lean request code): erl-lean-conn (b),
# erl-lean-loop (d), erl-lean-loop-socket (e). Busy-waiting on (-bw) for the two plain Erlang designs and Cowboy;
# everything else has it off. Natively, so that docker-proxy is not the limit; wrk2, because it reaches every
# server's limit from 2 CPUs.

# Settings as variants (experiments/erlang-variants/variants.list): cowboy-open = Cowboy without its two limits on a
# connection (closing after 5 s without a request and after 1,000 requests; the other servers have none);
# netty-wcpus = Netty with one worker per CPU of the server (as it comes: two); erl-loop-w2x and java-loop-w2x = the
# plain event loops with two workers per CPU, as Netty has by default.

# --- What is measured
SERVER_IMAGES=erl-conn=lt-erlang-a-nobw erl-conn-bw=lt-erlang-a erl-loop=lt-erlang-f-nobw erl-loop-bw=lt-erlang-f erl-lean-conn=lt-erlang-b-nobw erl-lean-loop=lt-erlang-d-nobw erl-lean-loop-socket=lt-erlang-e-nobw java-conn=st-java-pure-27 java-loop=lt-java-loop netty=st-java-netty-4-2-19 cowboy=st-erlang-cowboy-29-1-1-nobw cowboy-bw=st-erlang-cowboy-29-1-1 cowboy-open=lt-cowboy-open-nobw netty-wcpus=lt-netty-wcpus erl-loop-w2x=lt-erlang-f-nobw-w2x java-loop-w2x=lt-java-loop-w2x
SERVERS=erl-conn erl-conn-bw erl-loop erl-loop-bw erl-lean-conn erl-lean-loop erl-lean-loop-socket java-conn java-loop netty cowboy cowboy-bw cowboy-open netty-wcpus erl-loop-w2x java-loop-w2x
TOOLS=idle wrk2
SHAPE=rate
RATES=10000                                           # the first step, requests per second
RATE_GROWTH=2                                         # then doubling until a step is missed
MAX_RATE=1000000
LIMIT_PRECISION_PCT=5                                 # then searching the limit until held and missed are this close
MAX_P99_MS=100                                        # a step is also missed when p99 is above this
LOAD_PERCENTS=10 20 40 80 100                         # of the highest rate held
CONNECTIONS=100
SECONDS=60
WARMUP_SECONDS=20
PYTHON_REQUESTS=60000
REPEATS=3

# --- Where it runs
DEPLOY=native
SYSTEM_CPUS=0,4
TOOL_CPUS=1,5
SERVER_CPUS=2,3,6,7

# --- The machine: as the paper's HTTP campaigns
MACHINE=minimal
ENV_CPU_SPEED=1800
IDLE_SECONDS=0
