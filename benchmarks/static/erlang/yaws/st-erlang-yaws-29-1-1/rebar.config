{erl_opts, [debug_info]}.
%% Yaws 2.3.1 (latest)
{deps, [{yaws, {git, "https://github.com/erlyaws/yaws.git", {tag, "yaws-2.3.1"}}}]}.

{relx, [{release, {bench_yaws, "0.1.0"},
         [bench_yaws, {yaws, load}]},
        {dev_mode, false},
        {vm_args, "config/vm.args"},
        {include_erts, true},
        {extended_start_script, false}]}.
