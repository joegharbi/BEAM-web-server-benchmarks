# Profile: tolerable
# As minimal, but Wi-Fi stays on: for a laptop you reach over the network (SSH) or that must stay
# online while it measures. Background network traffic can add a little noise to the whole machine's
# energy; the container's energy is not affected.
#   make run CONFIG=configs/tolerable.config
#
# Settings not listed here have their default value (explained in bench.config.example).

# CPU at one fixed speed, no turbo, no other containers running
ENV_GOVERNOR=performance
ENV_TURBO=off
ENV_STOP_CONTAINERS=1

# Dimmed and switched off, except Wi-Fi (restored after)
ENV_SCREEN_BRIGHTNESS=1
ENV_KEYBOARD_LIGHT=off
ENV_WIFI=unchanged
ENV_BLUETOOTH=off

# Never measure on battery or on a machine that is not calm: wait instead
ON_BATTERY=wait
READY_ON_TIMEOUT=wait
