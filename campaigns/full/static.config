# Campaign (full), part "static": every server as it is and with BEAM busy-waiting off, in one shuffled order.
#   make run CONFIG=campaigns/full/static.config
# Decisions (pilot 2026-10-01, busy-wait experiment 2026-10-02):
#   - both scheduler settings: busy-waiting makes container energy unstable and inflated
#   - 5 repeats: whole-machine CV 0.4-2.7%, container CV <= 3.3% without busy-waiting
#   - no idle measurement: an idle server draws 0.1-2 mW
MACHINE=minimal
MEASURE=static
VARIANTS=nobw:ERL_FLAGS=+sbwt none +sbwtdcpu none +sbwtdio none
REPEATS=5
IDLE_SECONDS=0
# Full: 11 levels; from 5,000 requests (1,000 lasts ~1.3 s, only 1-2 power readings)
HTTP_REQUESTS=5000 8000 10000 15000 20000 30000 40000 50000 60000 70000 80000
