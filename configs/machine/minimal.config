# Profile: minimal
# The quietest machine, for measurements you publish. Use it on a laptop or desktop you control,
# and leave the machine alone while it measures.
# Used by a measurement file with MACHINE=minimal. Only machine settings belong here.
#
# Settings not listed here have their default value (every setting: docs/CONFIG.md). These are
# the defaults too; they are written out so this profile stays the same if a default ever changes.
# What to measure (servers, load levels, repeats, ...) goes in the measurement file.

# CPU at one fixed speed, no turbo, no other containers running
ENV_GOVERNOR=performance
ENV_TURBO=off
ENV_POWER_PROFILE=performance
ENV_STOP_CONTAINERS=1

# Everything that can be dimmed or switched off (restored after)
ENV_SCREEN_BRIGHTNESS=1
ENV_KEYBOARD_LIGHT=off
ENV_WIFI=off
ENV_BLUETOOTH=off

# Never measure on battery or on a machine that is not calm: wait instead
ON_BATTERY=wait
READY_ON_TIMEOUT=wait
