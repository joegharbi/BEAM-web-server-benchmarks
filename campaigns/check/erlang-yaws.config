# Check of the three converted Yaws servers (Yaws 2.3.1 embedded in a lean release on OTP 29.1.1;
# static, dynamic, WebSocket), each with busy-waiting as built and off, in Docker and natively, with
# the real Scaphandre: 16 measurements, about 25 min. Every row's "Server Processes" must be
# "beam.smp, erl_child_setup" (no epmd, no sleep loop, no yaws --status checks).
#   make run CONFIG=campaigns/check/erlang-yaws.config
MACHINE=minimal
MEASURE=static dynamic websocket
SERVERS=st-erlang-yaws-29-1-1 dy-erlang-yaws-29-1-1 ws-erlang-yaws-29-1-1
VARIANTS=nobw:ERL_FLAGS=+sbwt none +sbwtdcpu none +sbwtdio none
DEPLOY=container native
REPEATS=1
IDLE_SECONDS=0
HTTP_REQUESTS=20000
# One burst and one stream test per server
WS_BURST_CLIENTS=50
WS_BURST_SIZES_KB=8
WS_STREAM_CLIENTS=50
WS_STREAM_SIZES_KB=8
WS_STREAM_DURATION_SECONDS=10
