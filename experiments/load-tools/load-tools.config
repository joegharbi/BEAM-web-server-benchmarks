# Load tools experiment (experiments/load-tools/run.py): every setting in one file. Change it and run
#     ./srv/bin/python3 experiments/load-tools/run.py
# A command-line option (e.g. --seconds 10) overrides this file for one run.

# --- What is measured
SERVERS=erlang-nobw erlang-bw java                    # erlang-nobw, erlang-bw (busy-waiting on), java
TOOLS=idle python wrk2 oha k6 k6-paced vegeta         # idle = server on, no load; python = the framework's client
RATES=1000 2000 5000 10000 20000 40000 80000          # requests per second, a rising ramp
SECONDS=60                                            # length of every run
CONNECTIONS=100                                       # connections each tool may keep open at most
WARMUP_SECONDS=20                                     # unmeasured k6 load after each server start
PYTHON_REQUESTS=60000                                 # the Python client sends this many, as fast as it can
REPEATS=5

# --- Where it runs
DEPLOY=docker                                         # docker, native (no Docker), or both: docker native
# CPU split on this laptop (i7-10610U: 4 cores with 2 hardware threads each; core n = CPUs n and n+4), so that the
# tool and the server never share a core. all = no split.
SYSTEM_CPUS=0,4                                       # Linux, Docker, docker-proxy, Scaphandre, this script
TOOL_CPUS=1,5                                         # the load tool
SERVER_CPUS=2,3,6,7                                   # the server

# --- The machine: as the paper's HTTP campaigns (minimal profile, CPU fixed at 1800 MHz, turbo off)
MACHINE=minimal
ENV_CPU_SPEED=1800
IDLE_SECONDS=0
