# Short check of native mode: the converted Cowboy server in Docker and without Docker (same program,
# copied out of the image), each with busy-waiting as built and off, through the full framework with
# the real Scaphandre. 2 repeats, so the order rotates.
#   make run CONFIG=campaigns/check/native.config
MACHINE=minimal
MEASURE=static
SERVERS=st-erlang-cowboy-28-4-3
VARIANTS=nobw:ERL_FLAGS=+sbwt none +sbwtdcpu none +sbwtdio none
DEPLOY=container native
REPEATS=2
IDLE_SECONDS=0
HTTP_REQUESTS=20000
