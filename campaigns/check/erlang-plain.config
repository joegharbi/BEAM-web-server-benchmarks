# Check of the four converted plain Erlang servers (pure and index, static and dynamic), each with
# busy-waiting as built and off, in Docker and natively, with the real Scaphandre: 16 measurements,
# about 25 min. Every row's "Server Processes" must be "beam.smp, erl_child_setup" (no epmd).
#   make run CONFIG=campaigns/check/erlang-plain.config
MACHINE=minimal
MEASURE=static dynamic
SERVERS=st-erlang-pure-28-4-3 st-erlang-index-28-4-3 dy-erlang-pure-28-4-3 dy-erlang-index-28-4-3
VARIANTS=nobw:ERL_FLAGS=+sbwt none +sbwtdcpu none +sbwtdio none
DEPLOY=container native
REPEATS=1
IDLE_SECONDS=0
HTTP_REQUESTS=20000
