# Check of the three Java reference servers (Netty 4.2.19 on JDK 27, a jlink runtime under /app): static
# and dynamic HTTP and WebSocket, in Docker and natively, with the real Scaphandre: 8 measurements, about 13 min.
# The busy-waiting variant must be skipped for them ("nobw does not apply ... (it reads
# JAVA_TOOL_OPTIONS)"), and every row's "Server Processes" must be "java".
#   make run CONFIG=campaigns/check/java-netty.config
MACHINE=minimal
MEASURE=static dynamic websocket
SERVERS=st-java-netty-4-2-19 dy-java-netty-4-2-19 ws-java-netty-4-2-19
VARIANTS=nobw:ERL_FLAGS=+sbwt none +sbwtdcpu none +sbwtdio none
DEPLOY=container native
REPEATS=1
IDLE_SECONDS=0
HTTP_REQUESTS=20000
# One burst and one stream test
WS_BURST_CLIENTS=50
WS_BURST_SIZES_KB=8
WS_STREAM_CLIENTS=50
WS_STREAM_SIZES_KB=8
WS_STREAM_DURATION_SECONDS=10
