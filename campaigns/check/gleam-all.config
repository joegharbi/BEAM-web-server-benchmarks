# Check of all seven Gleam servers on Gleam 1.19.0 / OTP 29.1.1 (mist 6.0.3; pure = raw sockets, no framework),
# as Erlang shipments with their own Erlang: each with
# busy-waiting as built and off, in Docker and natively, with the real Scaphandre: 40 measurements,
# about 60 min. Every row's "Server Processes" must be "beam.smp, erl_child_setup".
#   make run CONFIG=campaigns/check/gleam-all.config
MACHINE=minimal
MEASURE=static dynamic websocket
SERVERS=st-gleam-pure-1-19-0 st-gleam-mist-1-19-0 st-gleam-index-1-19-0 dy-gleam-pure-1-19-0 dy-gleam-mist-1-19-0 dy-gleam-index-1-19-0 ws-gleam-mist-1-19-0
VARIANTS=nobw:ERL_FLAGS=+sbwt none +sbwtdcpu none +sbwtdio none
DEPLOY=container native
REPEATS=1
IDLE_SECONDS=0
HTTP_REQUESTS=20000
# One burst and one stream test per WebSocket server
WS_BURST_CLIENTS=50
WS_BURST_SIZES_KB=8
WS_STREAM_CLIENTS=50
WS_STREAM_SIZES_KB=8
WS_STREAM_DURATION_SECONDS=10
