# Load tools experiment, shape "clients" (closed model): N clients, each sends its next request as soon as the last
# one is answered. Run with
#     ./srv/bin/python3 experiments/load-tools/run.py --config experiments/load-tools/clients.config
# oha and k6 only (wrk2 and vegeta always send at a fixed rate).

# --- What is measured
SERVERS=erlang-nobw erlang-bw java
TOOLS=idle oha k6
SHAPE=clients
CLIENTS=1 10 100 1000                                 # clients connected at the same time
RATE_GROWTH=0                                         # the listed levels only
SECONDS=60
WARMUP_SECONDS=20
PYTHON_REQUESTS=60000
REPEATS=3

# --- Where it runs
DEPLOY=docker native
SYSTEM_CPUS=0,4
TOOL_CPUS=1,5
SERVER_CPUS=2,3,6,7

# --- The machine: as the paper's HTTP campaigns
MACHINE=minimal
ENV_CPU_SPEED=1800
IDLE_SECONDS=0
