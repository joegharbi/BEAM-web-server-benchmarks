# Measurement file:  make run CONFIG=bench.config
# Every line is optional; the value shown is the default. Every setting is explained in
# docs/CONFIG.md. The machine settings (CPU, turbo, screen, radios, readiness check) come from
# the MACHINE profile; any of them written here overrides the profile for this measurement.

# ===== Machine profile =====
# machine profile: minimal | tolerable | remote | cloud | untouched (configs/machine/), a .config file, or none
MACHINE=minimal

# ===== What to measure =====
# kinds: static dynamic websocket concurrency payload
MEASURE=static dynamic websocket concurrency payload
# server folder names, or TYPE:IMAGE; empty = every server found
SERVERS=
# folder searched for servers; empty = benchmarks/
BENCHMARKS_DIR=

# ===== How much =====
# runs of every measurement (each repeat = one pass over all servers)
REPEATS=5
# HTTP load levels (request counts)
HTTP_REQUESTS=100 1000 5000 8000 10000 15000 20000 30000 40000 50000 60000 70000 80000
# measure each server idle this long before its load; 0 = off
IDLE_SECONDS=0
# unmeasured traffic this long after the server starts; 0 = off
WARMUP_SECONDS=0

# ===== Failures and raw data =====
# stop after this many failed measurements in a row (1 = first failure, 0 = never)
FAILURES_STOP_AFTER=5
# Scaphandre's raw power logs: keep | delete
RAW_DATA=keep

# ===== Order of the runs =====
# 1 = shuffle the server order in every repeat, 0 = same order
SHUFFLE=1
# number that decides the order; empty = random (saved, to rerun the same order)
SHUFFLE_SEED=

# ===== Load and energy measurement =====
# parallel HTTP requests (threads), or system
HTTP_MAX_WORKERS=100
# reuse = one kept-alive connection per worker, per-request = a new one each time
HTTP_CONNECTION=reuse
# Scaphandre sampling step (ms)
SCAPH_STEP_MS=500

# ===== WebSocket workloads (full runs; --quick and --super-quick keep their short lists) =====
# burst test: client counts
WS_BURST_CLIENTS=5 50 100
# burst test: message sizes (KB)
WS_BURST_SIZES_KB=8 1024 65536
# burst test: bursts per client
WS_BURST_BURSTS=3
# pause between bursts (s); 0 = back to back
WS_BURST_INTERVAL_SECONDS=0.5
# stream test: client counts
WS_STREAM_CLIENTS=5 50 100
# stream test: message sizes (KB)
WS_STREAM_SIZES_KB=8 1024 65536
# stream test: messages per second per client
WS_STREAM_RATE_PER_SECOND=10
# stream test: seconds each client sends
WS_STREAM_DURATION_SECONDS=5
# concurrency test: client counts
WS_CONCURRENCY_CLIENTS=100 1000 5000
# concurrency test: message size (KB)
WS_CONCURRENCY_SIZE_KB=8
# payload test: client count
WS_PAYLOAD_CLIENTS=5
# payload test: message sizes (KB)
WS_PAYLOAD_SIZES_KB=8 1024 65536
