# Check of all ten Elixir servers on Elixir 1.20.4 / OTP 29.1.1 (Phoenix 1.8.15, Bandit 1.12.5, Plug.Cowboy 2.9.0
# with Cowboy 2.19.0, plain Elixir), as mix releases: each with
# busy-waiting as built and off, in Docker and natively, with the real Scaphandre: 48 measurements,
# about 70 min. Every row's "Server Processes" must be "beam.smp, erl_child_setup".
#   make run CONFIG=campaigns/check/elixir-all.config
MACHINE=minimal
MEASURE=static dynamic websocket
SERVERS=st-elixir-pure-1-20-4 st-elixir-index-1-20-4 st-elixir-cowboy-1-20-4 st-elixir-phoenix-1-8-15 dy-elixir-pure-1-20-4 dy-elixir-index-1-20-4 dy-elixir-cowboy-1-20-4 dy-elixir-phoenix-1-8-15 ws-elixir-cowboy-1-20-4 ws-elixir-bandit-1-12-5
VARIANTS=nobw:ERL_FLAGS=+sbwt none +sbwtdcpu none +sbwtdio none
DEPLOY=container native
REPEATS=1
IDLE_SECONDS=0
HTTP_REQUESTS=20000
# One burst and one stream test per WebSocket server
WS_BURST_CLIENTS=50
WS_BURST_SIZES_KB=8
WS_STREAM_CLIENTS=50
WS_STREAM_SIZES_KB=8
WS_STREAM_DURATION_SECONDS=10
