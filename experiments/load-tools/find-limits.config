# Load tools experiment: find every limit, with no fixed ceiling. Run with
#     ./srv/bin/python3 experiments/load-tools/run.py --config experiments/load-tools/find-limits.config
# Every tool climbs the listed rates, then keeps doubling until a step is missed, then searches between the last
# rate held and the first missed until they are within LIMIT_PRECISION_PCT. Every missed step says who broke:
# the server, the client (the load tool), both, or something in between (docker-proxy).

# --- What is measured
SERVERS=erlang-nobw erlang-bw java
TOOLS=idle wrk2 oha k6                                # idle = server on, no load
RATES=5000 10000 20000                                # the first steps, requests per second
RATE_GROWTH=2                                         # after them: next step = last step x 2 (0 = stop at the list's end)
MAX_RATE=1000000                                      # safety ceiling of the growing ramp
LIMIT_PRECISION_PCT=5                                 # search the limit until held and missed are this close (0 = off)
SECONDS=60
CONNECTIONS=100
WARMUP_SECONDS=20
PYTHON_REQUESTS=60000
REPEATS=3

# --- Where it runs
DEPLOY=docker native
SYSTEM_CPUS=0,4
TOOL_CPUS=1,5
SERVER_CPUS=2,3,6,7

# --- The machine: as the paper's HTTP campaigns
MACHINE=minimal
ENV_CPU_SPEED=1800
IDLE_SECONDS=0
