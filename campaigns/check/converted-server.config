# Short check of a converted server (lean release, PORT, no node name), as built and with
# busy-waiting off, through the full framework with the real Scaphandre.
#   make run CONFIG=campaigns/check/converted-server.config
MACHINE=minimal
MEASURE=static
SERVERS=st-erlang-cowboy-29-1-1
VARIANTS=nobw:ERL_FLAGS=+sbwt none +sbwtdcpu none +sbwtdio none
REPEATS=1
IDLE_SECONDS=0
HTTP_REQUESTS=20000
