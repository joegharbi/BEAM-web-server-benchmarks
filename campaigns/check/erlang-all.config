# Check of all ten Erlang servers on OTP 29.1.1 (Cowboy 2.19.0, Yaws 2.3.1, plain Erlang): each with
# busy-waiting as built and off, in Docker and natively, with the real Scaphandre: 48 measurements,
# about 70 min. Every row's "Server Processes" must be "beam.smp, erl_child_setup".
#   make run CONFIG=campaigns/check/erlang-all.config
MACHINE=minimal
MEASURE=static dynamic websocket
SERVERS=st-erlang-cowboy-29-1-1 st-erlang-pure-29-1-1 st-erlang-index-29-1-1 st-erlang-yaws-29-1-1 dy-erlang-cowboy-29-1-1 dy-erlang-pure-29-1-1 dy-erlang-index-29-1-1 dy-erlang-yaws-29-1-1 ws-erlang-cowboy-29-1-1 ws-erlang-yaws-29-1-1
VARIANTS=nobw:ERL_FLAGS=+sbwt none +sbwtdcpu none +sbwtdio none
DEPLOY=container native
REPEATS=1
IDLE_SECONDS=0
HTTP_REQUESTS=20000
# One burst and one stream test per WebSocket server
WS_BURST_CLIENTS=50
WS_BURST_SIZES_KB=8
WS_STREAM_CLIENTS=50
WS_STREAM_SIZES_KB=8
WS_STREAM_DURATION_SECONDS=10
