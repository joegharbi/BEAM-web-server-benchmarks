# Profile: untouched
# For a machine you do not control (a shared university server, a cloud machine): nothing on the
# machine is changed. The measurement still repeats, shuffles, checks readiness before every run and
# records everything (settings, machine state, versions) in metadata.json, so the conditions are known.
# Used by a measurement file with MACHINE=untouched. Only machine settings belong here.
#
# Settings not listed here have their default value (every setting: docs/CONFIG.md).

# Leave the CPU, other containers, screen and radios as they are
ENV_GOVERNOR=unchanged
ENV_TURBO=unchanged
ENV_STOP_CONTAINERS=0
ENV_SCREEN_BRIGHTNESS=unchanged
ENV_KEYBOARD_LIGHT=unchanged
ENV_WIFI=unchanged
ENV_BLUETOOTH=unchanged

# On a busy shared machine, waiting for calm may never end: after READY_MAX_WAIT_SECONDS it measures
# anyway and writes the reason in the CSV ("Ready Check" column). A machine without a battery is never
# affected by ON_BATTERY.
ON_BATTERY=wait
READY_ON_TIMEOUT=measure
