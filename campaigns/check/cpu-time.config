# Check of the CPU columns (v1.6.2: CPU time from the server's cgroup counter over exactly the load window).
# Two static servers, as built and -nobw, in Docker and natively, at 1800 MHz: 8 measurements, about 15 min.
# In every row Container Total CPU (%*s) must equal Container Avg CPU (%) x Execution Time (s), and the same
# server must use about the same CPU time in Docker and natively.
#   make run CONFIG=campaigns/check/cpu-time.config
MACHINE=minimal
ENV_CPU_SPEED=1800
MEASURE=static
SERVERS=st-erlang-pure-29-1-1 st-erlang-cowboy-29-1-1
VARIANTS=nobw:ERL_FLAGS=+sbwt none +sbwtdcpu none +sbwtdio none
DEPLOY=container native
REPEATS=1
IDLE_SECONDS=0
HTTP_REQUESTS=20000
